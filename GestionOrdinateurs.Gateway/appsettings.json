
{
  "ReverseProxy": {
    "Routes": {
      "ordinateurs-route": {
        "ClusterId": "ordinateurs-cluster",
        "Match": {
          "Path": "/ordinateurs/{**catch-all}"
        }
      },
      "reparations-route": {
        "ClusterId": "reparations-cluster",
        "Match": {
          "Path": "/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ordinateurs-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5267/"
          }
        }
      },
      "reparations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5267/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
