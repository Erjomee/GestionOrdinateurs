
@page "/ordinateurs"
@using GestionOrdinateurs.Shared
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage

<h3>Liste des ordinateurs</h3>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Devise</th>
            <th>Vendu</th>
        </tr>
    </thead>
    <tbody>
        @if (ordinateurs != null)
        {
            @foreach (var ordinateur in ordinateurs)
            {
                <tr>
                    <td>@ordinateur.Nom</td>
                    <td>@ordinateur.Prix</td>
                    <td>EUR</td>
                    <td>@(ordinateur.Vendu ? "Oui" : "Non")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Ordinateur>? ordinateurs;
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("token");

            if (string.IsNullOrWhiteSpace(token))
            {
                message = "Aucun token trouvé. Veuillez vous connecter.";
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync(
                "http://localhost:5010/ordinateurs");

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Erreur 401 : le token est refusé par l'API.";
                return;
            }

            response.EnsureSuccessStatusCode();

            ordinateurs = await response.Content
                .ReadFromJsonAsync<List<Ordinateur>>();

            message = ordinateurs == null || ordinateurs.Count == 0
                ? "Aucun ordinateur trouvé."
                : "";
        }
        catch (Exception ex)
        {
            message = $"Erreur : {ex.Message}";
        }
    }
}
